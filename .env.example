# Discord quick-start values from the Developer Portal.
APP_ID=1542822100941799484
PUBLIC_KEY=
DISCORD_TOKEN=

# Grookie controller settings.
GROOKIE_ALLOWED_ROLE_IDS=
GROOKIE_MODEL=
# Qwen3.8-Flash-Next: low, medium, or xhigh (default: low)
GROOKIE_REASONING_EFFORT=low
GROOKIE_STATE_PATH=state/grookie.json

# Lead intake: react with GROOKIE_LEAD_REACTION_EMOJI on a message to open an intake
# thread in GROOKIE_LEAD_CHANNEL_ID (a channel id, not a name). Leave the channel id
# unset to switch the reaction trigger off entirely.
GROOKIE_LEAD_CHANNEL_ID=
GROOKIE_LEAD_REACTION_EMOJI=🤝
# Where the interview records the contact. Defaults to scripts/lead-add.py in this repo.
GROOKIE_LEAD_SCRIPT=
# Where that script queues records. Defaults to ~/Library/Application Support/n0me/inbox
GROOKIE_LEAD_INBOX=
