<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>__LABEL__</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>__SCRIPT__</string>
  </array>
__USERNAME__
  <key>WorkingDirectory</key><string>__WORKDIR__</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <!-- 30s between attempts: enough that a bad build cannot hammer the Discord gateway. -->
  <key>ThrottleInterval</key><integer>30</integer>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>__HOME__</string>
    <key>PATH</key><string>__PATH__</string>
    <key>NODE_BIN</key><string>__NODE__</string>
  </dict>
  <!-- launchd appends to these; it never truncates, unlike `npm run start`. -->
  <key>StandardOutPath</key><string>__LOGDIR__/bridge.log</string>
  <key>StandardErrorPath</key><string>__LOGDIR__/bridge.log</string>
</dict>
</plist>
