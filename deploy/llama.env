# Machine-specific llama-server settings, read by deploy/run-llama-server.sh.
# Nothing secret in here - it is the command line the model server runs with.
# Put private or per-box overrides in llama.env.local (gitignored).

# Split GGUF: llama.cpp takes the first shard and loads the rest by name.
LLAMA_BIN=/Users/grookie/philipp/llama-prebuilt-b10796/llama-server
LLAMA_MODEL=/Users/grookie/philipp/unsloth/Qwen3.8-Flash-Next-UD-Q6_K_XL/Qwen3.8-Flash-Next-UD-Q6_K_XL-00001-of-00006.gguf

LLAMA_HOST=127.0.0.1
LLAMA_PORT=8080
LLAMA_CTX_SIZE=524288
LLAMA_PARALLEL=2
LLAMA_N_GPU_LAYERS=999
LLAMA_FIT=on
